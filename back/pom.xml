<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.coachrun</groupId>
    <artifactId>coachrun-back</artifactId>
    <version>0.4.0</version>
    <name>coachrun-back</name>
    <description>CoachRun — API de coaching course à pied</description>

    <properties>
        <java.version>21</java.version>
        <!-- Sans encodage explicite, javac utilise celui de la plateforme : dans un conteneur en
             locale POSIX, tous les accents des libellés français (e-mails, notifications) sont
             compilés en caractères de remplacement. -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <jjwt.version>0.12.5</jjwt.version>
        <springdoc.version>2.5.0</springdoc.version>
        <logback-logtail.version>0.3.6</logback-logtail.version>

        <!-- ====================================================================
             Montées de version imposées par le job « Vulnérabilités — dépendances
             backend » de la CI nocturne. Spring Boot 3.2.5 gère bien ces artefacts,
             mais y fige des versions désormais trouées. On relève UNIQUEMENT la
             ligne de correctif, à l'intérieur de la même version mineure, sans
             toucher au parent : la portée reste celle d'un correctif de sécurité.

             Chacune de ces propriétés doit disparaître lors de la montée de Spring
             Boot, dès que la version gérée par le parent dépassera celle exigée ici
             — les garder plus longtemps reviendrait à figer en arrière.
             ==================================================================== -->

        <!-- 10.1.20 portait 7 avis critiques, dont CVE-2025-24813 (exécution de code
             à distance sur écriture partielle du PUT). Les correctifs se sont
             échelonnés en 10.1.35, 10.1.55 puis 10.1.58 : on prend la dernière de la
             ligne 10.1. On n'en sort pas — Tomcat 11 implémente Jakarta EE 11, que
             Spring Boot 3.2 ne sait pas accueillir. -->
        <tomcat.version>10.1.59</tomcat.version>

        <!-- 4.1.109 → CVE-2026-75595, corrigée en 4.1.137. Netty n'entre ici que par
             async-http-client (Web Push), mais c'est le BOM de Spring Boot qui en
             arbitre la version : c'est donc ici, et pas dans la dépendance, qu'on la
             relève. Ligne 4.1 conservée — la 4.2 est une montée majeure de fait. -->
        <netty.version>4.1.138.Final</netty.version>

        <!-- 6.2.4 → CVE-2024-38821 : contournement d'autorisation sur les ressources
             statiques, corrigée en 6.2.7. On prend la dernière 6.2.x.

             ATTENTION — la montée s'arrête là, et pas par prudence : CVE-2026-22732
             touche elle aussi spring-security-web et n'est corrigée qu'en 6.5.9 et
             7.0.4. Or Spring Security 6.5 réclame Spring Framework 6.2, que Spring
             Boot n'apporte qu'à partir de sa 3.5 : la fermer exige la montée de
             Spring Boot, pas une propriété. En attendant, elle fait l'objet d'une
             dérogation datée et publiée chaque nuit (cf.
             .github/vulnerabilites-acceptees.tsv). -->
        <spring-security.version>6.2.8</spring-security.version>
    </properties>

    <!--
        async-http-client entre par `nl.martijndwars:web-push`, qui l'épingle en 2.10.4 :
        CVE-2024-53990, corrigée en 2.12.4. Spring Boot ne gère pas cet artefact — cette
        section est donc la seule façon de relever une version transitive sans forker la
        dépendance qui l'apporte.

        La montée reste interne à web-push : notre code ne touche jamais
        async-http-client directement, il ne connaît que `PushService` (cf.
        PushNotificationService). 2.12.4 est la dernière de la ligne 2.12, celle que
        web-push 5.1.1 sait utiliser ; la 3.x change de paquetage.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.asynchttpclient</groupId>
                <artifactId>async-http-client</artifactId>
                <version>2.12.4</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web / REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Validation (Jakarta) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Security stateless + JWT -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Migrations -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>
        <!-- Monitoring / health -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Sentry : remontée des erreurs (actif uniquement si SENTRY_DSN défini) -->
        <dependency>
            <groupId>io.sentry</groupId>
            <artifactId>sentry-spring-boot-starter-jakarta</artifactId>
            <version>7.14.0</version>
        </dependency>

        <!-- JWT (jjwt, HS512) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- OpenAPI / Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Web Push (VAPID) -->
        <dependency>
            <groupId>nl.martijndwars</groupId>
            <artifactId>web-push</artifactId>
            <version>5.1.1</version>
        </dependency>
        <!--
            Verrou distribué des tâches planifiées. Les planificateurs sont documentés « mono-
            instance » depuis le MVP : à deux instances, chacune enverrait le rappel J-1 et le
            digest, et chaque athlète recevrait tout en double. Le verrou s'appuie sur la base
            déjà présente — aucune infrastructure supplémentaire.
        -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>5.13.0</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>5.13.0</version>
        </dependency>
        <!-- Fournisseur JCE des clés ECDH du Web Push (cf. VapidKeys, PushNotificationService).
             1.78.1 → CVE-2025-14813, corrigée en 1.84. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.84</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- PostgreSQL (runtime prod/docker) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2 (tests : context load + validation Liquibase hors Docker) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Journalisation centralisée (Better Stack / Logtail).
             Sentry remonte les exceptions, Better Stack Uptime dit si l'API répond ; ni l'un
             ni l'autre ne voit les `log.warn` qui portent l'essentiel du diagnostic ici :
             topologie de proxy incohérente, file Strava saturée, verrou de connexion, cause
             exacte d'un refus de rafraîchissement. Sans journal cherchable, le correlationId
             renvoyé sur les 500 — et capté par le formulaire de retour bêta — ne mène nulle part.

             L'appender se DÉSACTIVE tout seul, avec un unique avertissement, si le token est
             absent : dev, tests et smoke test de CI ne sont donc pas bruyants (cf. logback-spring.xml,
             où il n'est de toute façon branché que sur le profil prod). -->
        <dependency>
            <groupId>com.logtail</groupId>
            <artifactId>logback-logtail</artifactId>
            <version>${logback-logtail.version}</version>
        </dependency>
        <!-- Export PDF (pur Java, sans dépendance native) -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>1.3.43</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>coachrun-back</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- expose la version applicative via /api/actuator/info -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
