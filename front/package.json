{
  "name": "coachrun-front",
  "version": "0.5.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:docker": "ng build --configuration production,docker",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox",
    "build:pwa": "ng build --configuration pwa",
    "start:pwa": "ng build --configuration pwa && npx --yes http-server dist/front/browser -p 4200 -c-1 --proxy http://localhost:4200?"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.35",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.35",
    "@angular/compiler": "^20.3.35",
    "@angular/core": "^20.3.35",
    "@angular/forms": "^20.3.35",
    "@angular/platform-browser": "^20.3.35",
    "@angular/platform-browser-dynamic": "^20.3.35",
    "@angular/router": "^20.3.35",
    "@angular/service-worker": "^20.3.35",
    "@sentry/angular": "^10.78.0",
    "leaflet": "^1.9.4",
    "lucide-angular": "1.0.0",
    "qrcode": "1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.42",
    "@angular/cli": "^20.3.42",
    "@angular/compiler-cli": "^20.3.35",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/qrcode": "1.5.5",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "puppeteer": "^25.1.0",
    "sharp": "^0.35.2",
    "typescript": "~5.8.3"
  }
}
